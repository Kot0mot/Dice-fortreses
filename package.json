{
  "name": "dice-fortresses",
  "version": "0.2.0",
  "private": true,
  "description": "Dice Fortresses — hybrid of Dice Kingdoms and Forts.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "cli": "tsc && node dist/cli.js",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run build && npm run web:build",
    "server": "tsc && node dist/server.js"
  },
  "keywords": [
    "game",
    "typescript"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/socket.io-client": "^1.4.36",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
